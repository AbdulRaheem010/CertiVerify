generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { SUPER_ADMIN ORGANIZATION_OWNER ORGANIZATION_ADMIN ORGANIZATION_STAFF CERTIFICATE_HOLDER }
enum InvitationStatus { PENDING ACCEPTED REVOKED }
enum CertificateStatus { VALID REVOKED EXPIRED }
enum OrganizationStatus { ACTIVE SUSPENDED }
enum PlanCode { FREE STARTER PRO ENTERPRISE }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(CERTIFICATE_HOLDER)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  memberships OrganizationMember[]
  recipient Recipient?
  auditLogs AuditLog[] @relation("AuditActor")
  resetTokens PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  invitations StaffInvitation[] @relation("InvitationAcceptedBy")
}
model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  logoUrl String?
  status OrganizationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  members OrganizationMember[]
  courses Course[]
  recipients Recipient[]
  certificates Certificate[]
  templates CertificateTemplate[]
  auditLogs AuditLog[]
  subscription Subscription?
  invitations StaffInvitation[]
  usageRecords UsageRecord[]
  @@index([status])
}
model OrganizationMember { id String @id @default(cuid()); userId String; organizationId String; role Role; isActive Boolean @default(true); user User @relation(fields:[userId],references:[id],onDelete:Cascade); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); @@unique([userId,organizationId]); @@index([organizationId]) }
model Course { id String @id @default(cuid()); organizationId String; name String; code String; description String?; duration String?; credentialLevel String?; skills String[]; certificateType String?; expirationDays Int?; defaultTemplateId String?; createdAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); certificates Certificate[]; @@unique([organizationId,code]); @@index([organizationId]) }
model Recipient { id String @id @default(cuid()); organizationId String; userId String? @unique; name String; email String; createdAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); user User? @relation(fields:[userId],references:[id]); certificates Certificate[]; @@unique([organizationId,email]); @@index([organizationId,email]) }
model CertificateTemplate { id String @id @default(cuid()); organizationId String; name String; design String @default("classic"); settings Json; isDefault Boolean @default(false); createdAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); certificates Certificate[]; @@index([organizationId]) }
model Certificate { id String @id @default(cuid()); certificateId String @unique; verificationCode String @unique; idempotencyKey String?; organizationId String; recipientId String; courseId String; templateId String?; title String; description String?; issueDate DateTime; expiryDate DateTime?; status CertificateStatus @default(VALID); grade String?; score Float?; credentialLevel String?; skills String[]; issuerName String?; issuerTitle String?; certificateFileUrl String?; qrCodeUrl String?; renewedFromId String?; version Int @default(1); revokedAt DateTime?; revokedReason String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); recipient Recipient @relation(fields:[recipientId],references:[id]); course Course @relation(fields:[courseId],references:[id]); template CertificateTemplate? @relation(fields:[templateId],references:[id]); prior Certificate? @relation("CertificateRenewals",fields:[renewedFromId],references:[id]); renewals Certificate[] @relation("CertificateRenewals"); verifications VerificationEvent[]; @@unique([organizationId,idempotencyKey]); @@index([organizationId,status,issueDate]); @@index([recipientId]); @@index([courseId]) }
model VerificationEvent { id String @id @default(cuid()); certificateId String; verifiedAt DateTime @default(now()); ipHash String?; userAgent String?; certificate Certificate @relation(fields:[certificateId],references:[id],onDelete:Cascade); @@index([certificateId,verifiedAt]) }
model AuditLog { id String @id @default(cuid()); organizationId String?; actorId String?; action String; resourceType String; resourceId String?; ipHash String?; metadata Json?; createdAt DateTime @default(now()); organization Organization? @relation(fields:[organizationId],references:[id],onDelete:Cascade); actor User? @relation("AuditActor",fields:[actorId],references:[id]); @@index([organizationId,createdAt]) }
model Plan { id String @id @default(cuid()); code PlanCode @unique; name String; monthlyCertificateLimit Int?; staffLimit Int?; templateLimit Int?; subscriptions Subscription[] }
model Subscription { id String @id @default(cuid()); organizationId String @unique; planId String; status String @default("active"); currentPeriodStart DateTime @default(now()); currentPeriodEnd DateTime; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); plan Plan @relation(fields:[planId],references:[id]) }
model PasswordResetToken { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; usedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }
model EmailVerificationToken { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; usedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }

model StaffInvitation { id String @id @default(cuid()); organizationId String; email String; role Role; tokenHash String @unique; status InvitationStatus @default(PENDING); expiresAt DateTime; acceptedAt DateTime?; revokedAt DateTime?; acceptedById String?; createdAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); acceptedBy User? @relation("InvitationAcceptedBy",fields:[acceptedById],references:[id]); @@index([organizationId,status]); @@index([email]) }
model UsageRecord { id String @id @default(cuid()); organizationId String; periodStart DateTime; periodEnd DateTime; certificatesIssued Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); @@unique([organizationId,periodStart]); @@index([organizationId,periodEnd]) }
